# AgentIndex — backend env
#
# Copy to .env and edit. Every value has an honest default.

# Memory backend selector
# sqlite (default): zero external deps, works on any VPS.
# hindsight: routes memory to a Hindsight server. See https://github.com/vectorize-io/hindsight
MEMORY_BACKEND=sqlite

# Only used when MEMORY_BACKEND=hindsight
HINDSIGHT_URL=http://localhost:8888

# Where the SQLite file lives (relative to server/app by default)
# AGENTINDEX_DB_PATH=/root/agentindex/server/agentindex.db

# ---------------------------------------------------------------------------
# $AIX launch switch — LEAVE UNSET UNTIL THE TOKEN IS ACTUALLY DEPLOYED.
#
# Unset  -> the app renders honest "Cooming soon" states everywhere: no
#           contract address shown, no trade link, no balances.
# Set    -> /api/index starts reporting aix_deployed=true, and the
#           frontend flips to live Uniswap swap links automatically
#           (zero code change).
# ---------------------------------------------------------------------------
# AGENTINDEX_AIX_TOKEN_ADDRESS=0x...

# ---------------------------------------------------------------------------
# Distribution feed — raw URL of the keeper bot's published snapshot
# (latest.json). LEAVE UNSET UNTIL THE FIRST CYCLE RUNS.
#
# Unset  -> /api/distributions returns live:false with the reason; the
#           Distribution tab shows the honest empty state.
# Set    -> the tab renders real cycles from the feed.
#
# Example:
# AGENTINDEX_FEED_URL=https://raw.githubusercontent.com/<org>/<data-repo>/main/latest.json
# ---------------------------------------------------------------------------
# AGENTINDEX_FEED_URL=
